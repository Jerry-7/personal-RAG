# =============================================================================
# Personal RAG — 环境变量配置
# =============================================================================
# 使用方法: 复制此文件为 .env 并根据需要修改
#   cp .env.example .env
#
# 所有配置项都有默认值，不创建 .env 文件也能直接运行。
# =============================================================================


# ── 应用基础配置 ──────────────────────────────────────────────────────────
# APP_NAME=Personal RAG
# APP_VERSION=0.1.0
# DEBUG=true                          # 开启后 SQL 日志会输出到控制台


# ── 数据存储路径（相对于 backend/ 目录）───────────────────────────────────
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# CHROMA_DIR=./data/faiss             # 注意: 字段名遗留自 ChromaDB，实际存储 FAISS 索引
# TRANSCRIPT_DIR=./data/transcripts


# ── Ollama 配置（默认 Provider）────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text     # README 推荐; 如果失败可用 bge-m3
OLLAMA_LLM_MODEL=qwen2.5:14b                # 中文推荐; 小显存可用 qwen2.5:7b


# ── OpenAI 配置（可选 fallback）────────────────────────────────────────────
# 设置 API Key 后可通过前端设置面板切换到 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ── Anthropic 配置（可选 fallback）─────────────────────────────────────────
# 设置 API Key 后可通过前端设置面板切换到 Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_LLM_MODEL=claude-sonnet-4-20250514


# ── 默认 Provider 选择 ─────────────────────────────────────────────────────
# 可选值: llm_provider = "ollama" | "openai" | "anthropic"
#         embedding_provider = "ollama" | "openai"
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama


# ── RAG 参数 ───────────────────────────────────────────────────────────────
# CHUNK_SIZE=1000                     # 文本分块大小（字符数）
# CHUNK_OVERLAP=200                   # 相邻分块重叠字符数
# RETRIEVAL_TOP_K=8                   # FAISS 初始检索数量
# FINAL_TOP_K=4                       # 最终注入 prompt 的分块数
# EMBEDDING_BATCH_SIZE=32             # embedding 时每批处理的文本数


# ── 后台任务配置 ───────────────────────────────────────────────────────────
# MAX_CONCURRENT_INDEXING_TASKS=10    # 同时索引的最大文档数
# INDEXING_SHUTDOWN_TIMEOUT_SECS=30   # 关闭时等待索引任务完成的秒数


# ── Agent 配置 ─────────────────────────────────────────────────────────────
# AGENT_MAX_ITERATIONS=5              # Agent 最大推理步数
# AGENT_CONTEXT_MAX_CHARS=24000       # 对话上下文最大字符数
# AGENT_INPUT_REWRITE_ENABLED=true    # 根据对话将追问改写为独立请求
# AGENT_INPUT_MAX_CHARS=12000         # 单次用户输入最大字符数
# AGENT_INPUT_HISTORY_MAX_CHARS=12000 # 输入改写可使用的历史上下文上限


# AGENT_FAST_MODEL=                    # Fast-tier model; empty uses provider default
# AGENT_STANDARD_MODEL=                # Standard-tier model; empty uses provider default
# AGENT_EXPERT_MODEL=                  # Expert-tier model; empty uses provider default

# ── 网页研究（自托管 SearXNG）──────────────────────────────────────────────
# SEARXNG_BASE_URL=http://127.0.0.1:8888
# WEB_SEARCH_LANGUAGE=all
# WEB_SAFE_SEARCH=1
# WEB_FETCH_TIMEOUT_SECS=10
# WEB_PAGE_BUDGET=8
# WEB_CRAWL_MAX_DEPTH=2
# WEB_SNAPSHOT_RETENTION_DAYS=30


# ── 文件上传限制 ───────────────────────────────────────────────────────────
# MAX_UPLOAD_SIZE_MB=500              # 单文件最大体积（MB）
# ALLOWED_EXTENSIONS=["pdf","docx","doc","txt","md","csv","mp4","mp3","avi","mkv","mov","wav","jpg","jpeg","png","bmp","tiff"]
